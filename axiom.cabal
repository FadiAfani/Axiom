cabal-version:      3.0
name:               axiom
version:            0.1.0.0

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  build-depends:    base, text

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Axiom.Syntax
                    Axiom.Parser
  build-depends:    megaparsec

executable mylang
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    axiom

test-suite tests
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:    axiom, tasty, tasty-hunit
